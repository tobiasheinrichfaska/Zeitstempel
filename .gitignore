# Dependencies & build output
node_modules/
dist/
coverage/

# Project-bound scratch area (workspace rule: never use global temp)
.tmp/

# Relay key files: they hold public keys only, but stay local configuration (whoever writes the file
# decides who may stamp); and a private key must never end up next to them
relay-keys*.json
*.keys.json
*keys*.json

# Local environment / editor
.env
.env.*
.vscode/
.idea/
*.wsb

# Data files (workspace checklist private → public)
*.xlsx
*.csv
*.db
*.sqlite*
*.log

# OS junk
.DS_Store
Thumbs.db
desktop.ini
