# Einstellungen des Zeitstempel-Relays (Pilot: eine Instanz, nur FreeTSA, Einzelbetrieb).
# Kopieren nach /etc/zeitstempel/relay.env (systemd: EnvironmentFile) oder als --env-file für Docker.
# Format: KEY=Wert, ein Eintrag je Zeile, keine Anführungszeichen, Kommentare nur auf eigenen Zeilen
# (systemd und Docker kennen keine Kommentare hinter einem Wert). Alle Werte hier sind Platzhalter.
# Bedeutung und Grenzen jeder Einstellung: docs/relay.md, Abschnitt "Start".

# Port, 1 bis 65535, nur Dezimalziffern. Proxy und Firewall brauchen einen bekannten Port.
PORT=8080

# Lauschadresse. Vorgabe 127.0.0.1 (Proxy auf demselben Rechner). Im Container 0.0.0.0 (das Image setzt es schon):
# dann den Port nur an die Loopback-Adresse des Hosts binden (-p 127.0.0.1:8080:8080).
RELAY_HOST=127.0.0.1

# Pflicht: die angebotenen Dienste, durch Komma getrennt. Pilot: nur FreeTSA (docs/dienste.md: einziger Dienst mit
# ausdrücklich erlaubter allgemeiner Nutzung).
RELAY_SERVICES=freetsa

# Pflicht (ohne RELAY_AUTH=off): Pfad der Schlüsseldatei mit den öffentlichen Schlüsseln. Kein Geheimnis, aber nur der
# Betreiber darf sie schreiben. Wird alle 5 s neu gelesen. Nie im Repository ablegen.
RELAY_KEYS_FILE=/etc/zeitstempel/relay-keys.json

# Browser-Herkünfte der App, durch Komma getrennt, genau https://host[:port] (ohne Pfad, ohne Schrägstrich am Ende).
RELAY_ORIGINS=https://app.example

# Längste Wartezeit einer Anfrage auf den Mindestabstand zum Dienst (1000 bis 60000 ms), danach 503 busy.
# Bestimmt die Fristen von Proxy und App: Einzelbetrieb mindestens Wartezeit + 17 s (30000 -> 47 s, Proxy 50 s).
RELAY_MAX_WAIT_MS=30000

# Leerlauf einer Verbindung zwischen zwei Anfragen (1000 bis 120000 ms). Vorgabe: 65000 bei Loopback, sonst 5000.
# Nur setzen, wenn ein Proxy auf einem anderen Rechner eine längere Leerlaufzeit hat als 5 s.
# RELAY_KEEPALIVE_MS=65000

# Sammelbetrieb (aus im Pilot): Fenster in ms (1000 bis 60000, mindestens der Mindestabstand des Dienstes; FreeTSA 5000).
# Alle Hashes eines Fensters werden zu einem Merkle-Baum, der Dienst sieht nur die Wurzel. Verlängert die Antwortzeit
# und die Fristen (docs/relay.md, "Sammelbetrieb"). Leer oder 0 = aus.
# RELAY_BATCH_MS=5000
# Sammelbetrieb: höchstens so viele Anfragen in einem Fenster (2 bis 1024, Vorgabe 128).
# RELAY_BATCH_MAX=128

# Dienste, die nur über http antworten (digicert, certum), nur mit 1 zulassen. Pilot: aus, Zeile bleibt weg.
# RELAY_ALLOW_PLAIN_HTTP=1

# Zugangsdaten eines bezahlten Dienstes, den das Relay selbst hält (nur wenn services.json einen Dienst mit auth.source
# "relay" oder "either" enthält; <ID> = Kennung in Großbuchstaben, '-' als '_'). basic: Benutzer:Passwort, sonst das
# Token. Das ist ein GEHEIMNIS: Datei nur für root und den Relay-Benutzer lesbar (Modus 0640), nie ins Repository.
# Im Pilot (nur FreeTSA) nicht gebraucht.
# RELAY_UPSTREAM_AUTH_<ID>=<Benutzer:Passwort oder Token>

# RELAY_AUTH=off startet das Relay ohne Schlüssel und nur auf Loopback: ausschließlich für die lokale Entwicklung,
# nie im Betrieb. Absichtlich nicht gesetzt; zusammen mit RELAY_KEYS_FILE wird es ohnehin abgelehnt.
# RELAY_AUTH=off
