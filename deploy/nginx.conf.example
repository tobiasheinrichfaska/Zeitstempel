# nginx vor dem Zeitstempel-Relay (Pilot: Einzelbetrieb, nur FreeTSA).
# NICHT GEGEN EINEN ECHTEN nginx GETESTET (in der Entstehungsumgebung war keiner installiert); geprüft nur statisch
# (tests/ops-templates.test.ts) und gegen die Zahlen in docs/relay.md, "Betrieb hinter einem Reverse-Proxy".
# Vor dem Einsatz selbst prüfen: nginx -t. Dieses Fragment gehört in den http-Block (z. B. /etc/nginx/conf.d/zeitstempel.conf).
#
# Regeln (docs/relay.md):
#  - Pfad unverändert weitergeben: kein URI hinter proxy_pass, kein rewrite, keine Abfrage.
#  - Origin und X-Zeitstempel-Auth gehen von selbst durch; nicht mit proxy_set_header leeren.
#  - Ratenlimit je Adresse NUR auf /v1/stamp/ (nicht auf Preflight, /health, /v1/services), und deutlich unter
#    perMinutePerKey (20): hier 5 je Minute, Burst 3.
#  - Lese-Frist: Einzelbetrieb mindestens RELAY_MAX_WAIT_MS + 17 s = 47 s, hier 50 s (3 s Reserve).
#    Sammelbetrieb (RELAY_BATCH_MS gesetzt): mindestens RELAY_MAX_WAIT_MS + Fenster + Kette + 17 s; 130 s ist die
#    sichere Obergrenze für die Vorgabe (30 s Wartegrenze, kleinstes RELAY_BATCH_MAX: 112 s bis 125 s).
#  - Genau eine Relay-Instanz je Schlüsseldatei: nur ein server-Eintrag im upstream-Block.
#  - /metrics (RELAY_METRICS=1) NIE nach außen weitergeben: für das Relay hat jede Anfrage über diesen Proxy eine
#    Loopback-Gegenstelle, es kann sie nicht von einem Aufruf aus dem Netz unterscheiden. Der Block "location ^~ /metrics"
#    unten sperrt den Pfad; abgeholt wird direkt am Relay (curl http://127.0.0.1:8080/metrics auf dem Rechner).
#  - X-Forwarded-For wird nicht ans Relay gegeben: das Relay kennt keine Adressen und wertet den Kopf nicht aus.

# Der Preflight (OPTIONS) bekommt einen leeren Schlüssel: nginx begrenzt ihn nicht.
map $request_method $zs_key {
    OPTIONS  "";
    default  $binary_remote_addr;
}
limit_req_zone  $zs_key zone=zs_rate:10m rate=5r/m;
limit_conn_zone $binary_remote_addr zone=zs_conn:10m;

upstream zeitstempel_relay {
    server 127.0.0.1:8080;
    keepalive 8;                            # ohne diesen Block hält nginx keine Verbindung zum Relay offen
}

# Klartext-Port: nur Weiterleitung auf https.
server {
    listen 80;
    server_name relay.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name relay.example;

    # TLS ist Pflicht (der Kopf X-Zeitstempel-Auth und der Hash laufen hier durch). Zertifikat und Schlüssel: eigene Einrichtung.
    ssl_certificate         /etc/ssl/zeitstempel/fullchain.pem;
    ssl_certificate_key     /etc/ssl/zeitstempel/privkey.pem;
    ssl_protocols           TLSv1.2 TLSv1.3;

    client_max_body_size   1k;              # das Relay lehnt mehr als 512 Byte ab
    client_header_timeout  6s;
    client_body_timeout    6s;

    # Die Zähler des Relays gehören nicht ins Netz (Präfix ^~ fängt auch /metrics/… und kodierte Schreibweisen ab).
    location ^~ /metrics {
        return 404;
    }

    # Alles außer dem Stempel: ohne Ratenlimit (Preflight, /health, /v1/services); die Verbindungsgrenze bleibt.
    location / {
        limit_conn zs_conn 10;
        limit_conn_status 429;

        proxy_pass http://zeitstempel_relay;   # ohne Pfad hinter der Adresse: der Pfad bleibt unverändert
        proxy_http_version 1.1;
        proxy_set_header Connection "";     # nur zusammen mit keepalive im upstream-Block wirksam
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For "";   # nicht ans Relay geben (kein Vertrauen, keine Auswertung)
        proxy_connect_timeout 5s;
        proxy_read_timeout    10s;
        proxy_redirect off;
    }

    # Nur der Stempel wird je Adresse gedrosselt; der Preflight (OPTIONS) zählt nicht mit (leerer Schlüssel oben).
    location /v1/stamp/ {
        limit_req  zone=zs_rate burst=3 nodelay;   # je Adresse 5 je Minute, nie das ganze Schlüsselbudget
        limit_conn zs_conn 10;
        limit_req_status  429;
        limit_conn_status 429;

        proxy_pass http://zeitstempel_relay;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For "";
        proxy_connect_timeout 5s;
        proxy_send_timeout    20s;
        # Einzelbetrieb (Pilot): RELAY_MAX_WAIT_MS 30000 + 17 s = 47 s, mit 3 s Reserve 50 s.
        # Bei anderer Wartegrenze W: W + 17 s + 3 s. Im Sammelbetrieb stattdessen 130s (sichere Obergrenze, siehe oben).
        proxy_read_timeout    50s;
        proxy_redirect off;
    }
}
